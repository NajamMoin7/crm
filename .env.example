# MongoDB connection for the online deployment (e.g. MongoDB Atlas). Leave unset to use
# the local database the app starts by itself in .data/mongo. Never use a production database.
#
# This file is committed to Git: keep the placeholder below. Put the real value only
# in Netlify (Site configuration → Environment variables), never in this file.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
