# Hosted PostgreSQL demo database (e.g. Neon or Supabase). Leave unset to use the
# local embedded database in .data/pglite. Never point this at a production database.
#
# This file is committed to Git: keep the placeholder below. Put the real value only
# in Netlify (Site configuration → Environment variables), never in this file.
DATABASE_URL=postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require
